{
  "name": "dailynagger",
  "private": true,
  "scripts": {
    "mobile:web": "npm run web --prefix src/DailyNagger.Mobile",
    "mobile:android": "npm run android --prefix src/DailyNagger.Mobile",
    "mobile:typecheck": "npm run typecheck --prefix src/DailyNagger.Mobile",
    "mobile:lint": "npm run lint --prefix src/DailyNagger.Mobile",
    "mobile:lint:fix": "npm run lint:fix --prefix src/DailyNagger.Mobile",
    "mobile:format": "npm run format --prefix src/DailyNagger.Mobile",
    "mobile:format:check": "npm run format:check --prefix src/DailyNagger.Mobile",
    "mobile:bump-build": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-mobile-build.ps1",
    "contracts:format": "npm run format --prefix src/api-contracts",
    "contracts:format:check": "npm run format:check --prefix src/api-contracts",
    "contracts:update": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/update-api-contracts.ps1",
    "contracts:generate": "npm run generate --prefix src/api-contracts",
    "contracts:typecheck": "npm run typecheck --prefix src/api-contracts",
    "contracts:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-api-contracts.ps1",
    "server:format": "dotnet format DailyNagger.sln --no-restore",
    "server:format:check": "dotnet format DailyNagger.sln --verify-no-changes --no-restore",
    "server:test": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/test-server.ps1",
    "api:dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-api.ps1",
    "db:reset": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/reset-local-db.ps1",
    "client:dev": "npm run dev --prefix src/DailyNagger.Client",
    "client:build": "npm run build --prefix src/DailyNagger.Client",
    "test": "dotnet test DailyNagger.sln --no-restore"
  }
}

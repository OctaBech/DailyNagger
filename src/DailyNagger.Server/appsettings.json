{
  "ConnectionStrings": {
    "DailyNaggerData": "Server=tcp:localhost,1433;Database=DailyNaggerData;User Id=sa;Password=replace-with-local-password;Encrypt=True;TrustServerCertificate=True",
    "DailyNaggerControl": "Server=tcp:localhost,1433;Database=DailyNaggerControl;User Id=sa;Password=replace-with-local-password;Encrypt=True;TrustServerCertificate=True"
  },
  "DataDbConnection": {
    "CacheMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
